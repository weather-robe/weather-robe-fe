<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="30dp"
        android:background="@drawable/modal_background">

        <LinearLayout
            android:id="@+id/layoutDateRow"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11월 15일"
                android:fontFamily="@font/nanumbarungothicbold"
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvTempInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   최고 16° / 최저 1°"
                android:textSize="16dp"
                android:textColor="#5D5D5D"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 오늘의 코디 키워드 -->
        <LinearLayout
            android:id="@+id/layoutCodi"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvCodiTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 코디 키워드"
                android:fontFamily="@font/nanumbarungothicbold"
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvCodiDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘은 어제보다 추워졌고, 날씨는 전반적으로 흐려요."
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/nanumbarungothic"
                android:textSize="12dp"
                android:textColor="#777777"
                android:layout_marginTop="14dp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/keywordContainer"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>




            </LinearLayout>

        </LinearLayout>

        <!-- feeling status -->
        <TextView
            android:id="@+id/tvKeywords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="@font/nanumbarungothicbold"
            android:textSize="18dp"
            android:textColor="#111111"
            android:layout_marginTop="10dp"/>


        <TextView
            android:id="@+id/tvUserAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="@font/nanumbarungothicbold"
            android:textSize="18dp"
            android:textColor="#111111"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>




    </LinearLayout>

</ScrollView>
