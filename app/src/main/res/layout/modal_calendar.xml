<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/modal_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 날짜 + 날씨 -->
        <LinearLayout
            android:id="@+id/layoutWeather"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDateTitle"
                    android:text="11월 15일 날씨"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <TextView
                    android:id="@+id/tvTempInfo"
                    android:text="   최고 16° / 최저 1°"
                    android:textSize="15sp"
                    android:textColor="#666666"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>


        <!-- 코디 키워드 -->
        <LinearLayout
            android:id="@+id/layoutCodi"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvCodiTitle"
                android:text="오늘의 코디 키워드"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <TextView
                android:id="@+id/tvCodiDescription"
                android:text="설명 텍스트"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:id="@+id/layoutCodiIcons"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <!-- Chip: 두꺼운 아우터 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/chip_background"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="🧥"
                        android:textSize="20sp"
                        android:paddingRight="4dp"/>

                    <TextView
                        android:text="두꺼운 아우터"
                        android:textSize="14sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Chip: 니트 -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@drawable/chip_background"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:text="🥼"
                        android:textSize="20sp"
                        android:paddingRight="4dp"/>

                    <TextView
                        android:text="니트"
                        android:textSize="14sp"
                        android:textColor="#333333"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>


        <!-- 사용자 대답 -->
        <TextView
            android:id="@+id/tvUserAnswer"
            android:text="나는 😃적당 이라고 답변했어요."
            android:textSize="16sp"
            android:textColor="#111111"
            android:layout_marginTop="32dp"/>

    </LinearLayout>

</ScrollView>
