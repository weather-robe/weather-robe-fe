<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/home_weather_dialog"
    android:clipToOutline="true"
    android:layout_marginTop="87dp">

    <!-- grabber: 패딩 영향 밖에서 화면 전체 기준 중앙 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/dialog_grabber"
            android:layout_width="123dp"
            android:layout_height="4dp"
            android:src="@drawable/dialog_grabber"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="35dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관심 항목 설정"
            android:textSize="18sp"
            android:fontFamily="@font/nanumbarungothicbold"
            android:textColor="#111111" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 선택 항목"
            android:textSize="13sp"
            android:fontFamily="@font/nanumbarungothic"
            android:textColor="#5D5D5D"
            android:layout_marginTop="10dp" />

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <include
                android:id="@+id/feel_card1"
                layout="@layout/home_feel_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/pop_card1"
                layout="@layout/home_pop_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/pm10_card1"
                layout="@layout/home_pm_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="바꾸고 싶은 항목 선택 후 아래 ‘확인’ 버튼을 눌러주세요."
            android:textSize="13sp"
            android:fontFamily="@font/nanumbarungothic"
            android:layout_marginTop="30dp"
            android:textColor="#5D5D5D" />

        <!-- OPTION ROW 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:weightSum="3">

            <include
                android:id="@+id/feel_card2"
                layout="@layout/home_feel_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/pop_card2"
                layout="@layout/home_pop_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/rain_card"
                layout="@layout/home_rain_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- OPTION ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="3">

            <include
                android:id="@+id/humidity_card"
                layout="@layout/home_humidity_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/wind_card"
                layout="@layout/home_wind_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space android:layout_width="13dp" android:layout_height="0dp" />

            <include
                android:id="@+id/pm10_card2"
                layout="@layout/home_pm_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- OPTION ROW 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="3">

            <include
                android:id="@+id/pm25_card"
                layout="@layout/home_pm25_card_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>

    <!-- 확인 버튼: 독립 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="30dp">

        <TextView
            android:id="@+id/btn_check"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/btn_check"
            android:text="확인"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="14sp"
            android:fontFamily="@font/nanumbarungothic"/>
    </LinearLayout>

</LinearLayout>
