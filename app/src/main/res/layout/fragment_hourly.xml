<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

        <LinearLayout
            android:id="@+id/weather_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <LinearLayout
                android:id="@+id/weather_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="104dp">

                <LinearLayout
                    android:layout_width="97dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingRight="19dp">

                    <TextView
                        android:id="@+id/txt_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00월 00일"
                        android:textColor="#000000"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/nanumbarungothicbold"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-요일"
                        android:textColor="#000000"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/nanumbarungothic"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="기온"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:text="체감온도"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:text="강수확률"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:text="강수량"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:text="습도"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:layout_marginBottom="23dp"
                        android:text="바람"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:fontFamily="@font/nanumbarungothic" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#EAEAEA" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_weather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EAEAEA" />

            <LinearLayout
                android:id="@+id/pm_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="23dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="28dp">

                <include
                    android:id="@+id/pm10_card"
                    layout="@layout/item_pm_hour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/pm25_card"
                    layout="@layout/item_pm_hour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

</ScrollView>
