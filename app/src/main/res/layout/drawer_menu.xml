<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="16dp"
    android:paddingRight="20dp"
    android:paddingBottom="36dp">

    <LinearLayout
        android:id="@+id/top_menu_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="30dp">

            <!-- 로고 -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_logo_thr"
                android:layout_marginLeft="12dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 닫기 버튼 -->
            <ImageView
                android:id="@+id/close_btn"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/close_btn"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- 공지사항 -->
        <LinearLayout
            android:id="@+id/menu_notice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginLeft="26dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_announcement" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="1dp"
                android:text="공지사항"
                android:textSize="18sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="14dp" />


        <!-- 1:1 문의 -->
        <LinearLayout
            android:id="@+id/menu_support"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginLeft="26dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_inquiry" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="1dp"
                android:text="1:1 문의"
                android:textSize="18sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="14dp" />

        <!-- 개인정보 설정 -->
        <LinearLayout
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginLeft="26dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="1dp"
                android:text="설정"
                android:textSize="18sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic" />
        </LinearLayout>
    </LinearLayout>

    <!-- 로그아웃 -->
    <LinearLayout
        android:id="@+id/menu_logout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_logout" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="로그아웃"
            android:textSize="18sp"
            android:textColor="#111111"
            android:fontFamily="@font/nanumbarungothic" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
