<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginLeft="9dp"
    android:layout_marginRight="9dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_bottom_bar">

    <LinearLayout
        android:id="@+id/tab_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/inner_home"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_home" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_hourly"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/inner_hourly"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_hourly"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_hourly" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_daily"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/inner_daily"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_daily"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_daily" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_calendar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/inner_calendar"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_calendar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_calendar" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
