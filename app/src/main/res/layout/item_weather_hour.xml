<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="63dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/root_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="14시"
            android:textSize="12sp"
            android:textColor="#000000"
            android:fontFamily="@font/nanumbarungothic"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/img_weather"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_weather_sunny" />

        <TextView
            android:id="@+id/txt_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#000000"
            android:fontFamily="@font/nanumbarungothicbold"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/row_feel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_feel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#000000"
                android:fontFamily="@font/nanumbarungothic"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_rainProb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:textSize="13sp"
            android:textColor="#000000"
            android:fontFamily="@font/nanumbarungothic"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/row_rainAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_rainAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#000000"
                android:fontFamily="@font/nanumbarungothic"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txt_humidity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="17dp"
            android:textSize="13sp"
            android:textColor="#000000"
            android:fontFamily="@font/nanumbarungothic"
            android:gravity="center"/>

        <LinearLayout
            android:id="@+id/row_wind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_wind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#000000"
                android:fontFamily="@font/nanumbarungothic"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txt_wind_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:textColor="#000000"
                android:fontFamily="@font/nanumbarungothic"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/blue_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#125588FF"
        android:visibility="gone"/>
</FrameLayout>
