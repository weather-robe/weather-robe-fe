<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 스크롤 영역 -->
    <ScrollView
        android:id="@+id/scroll_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingTop="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center_horizontal">

            <!-- 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                android:textSize="28sp"
                android:textColor="#000000"
                android:fontFamily="@font/nanumbarungothicbold"
                android:layout_gravity="start"
                android:layout_marginTop="104dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="어쩌구저쩌구"
                android:textSize="12sp"
                android:textColor="#9C9C9C"
                android:fontFamily="@font/nanumbarungothic"
                android:layout_gravity="start"
                android:layout_marginTop="2dp"/>


            <!-- 아이디 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아이디"
                android:textSize="12sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic"
                android:layout_gravity="start"
                android:layout_marginTop="53dp"/>

            <EditText
                android:id="@+id/input_id"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/edittext_selector"
                android:paddingLeft="15dp"
                android:textColor="#111111"
                android:gravity="center_vertical|start"
                android:fontFamily="@font/nanumbarungothic"
                android:hint="아이디 입력(6~20자 영어 소문자, 숫자)"
                android:textAppearance="@style/HintTextStyle"
                android:textColorHint="#C7C7C7"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"/>

            <LinearLayout
                android:id="@+id/id_error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/id_warn"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/id_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아이디는 6~20자 영어 소문자, 숫자만 가능합니다."
                    android:textSize="12sp"
                    android:textColor="#FF0C00"
                    android:fontFamily="@font/nanumsquarebold"
                    android:visibility="gone"/>
            </LinearLayout>


            <!-- 비밀번호 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호"
                android:textSize="12sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic"
                android:layout_gravity="start"
                android:layout_marginTop="30dp"/>

            <EditText
                android:id="@+id/input_pw"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/edittext_selector"
                android:paddingLeft="15dp"
                android:textColor="#111111"
                android:gravity="center_vertical|start"
                android:fontFamily="@font/nanumbarungothic"
                android:hint="비밀번호 입력(문자, 숫자, 특수문자 포함 8~20자)"
                android:textAppearance="@style/HintTextStyle"
                android:textColorHint="#C7C7C7"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"/>

            <LinearLayout
                android:id="@+id/pw_error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pw_warn"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pw_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호는 문자, 숫자, 특수문자 포함 8~20자만 가능합니다."
                    android:textSize="12sp"
                    android:textColor="#FF0C00"
                    android:fontFamily="@font/nanumsquarebold"
                    android:visibility="gone"/>
            </LinearLayout>


            <!-- 비밀번호 확인 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 확인"
                android:textSize="12sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic"
                android:layout_gravity="start"
                android:layout_marginTop="30dp"/>

            <EditText
                android:id="@+id/input_pw_check"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/edittext_selector"
                android:paddingLeft="15dp"
                android:textColor="#111111"
                android:gravity="center_vertical|start"
                android:fontFamily="@font/nanumbarungothic"
                android:hint="비밀번호 입력(문자, 숫자, 특수문자 포함 8~20자)"
                android:textAppearance="@style/HintTextStyle"
                android:textColorHint="#C7C7C7"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"/>

            <LinearLayout
                android:id="@+id/pw_check_error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/pw_check_warn"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pw_check_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호가 일치하지 않습니다."
                    android:textSize="12sp"
                    android:textColor="#FF0C00"
                    android:fontFamily="@font/nanumsquarebold"
                    android:visibility="gone"/>
            </LinearLayout>


            <!-- 이메일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textSize="12sp"
                android:textColor="#111111"
                android:fontFamily="@font/nanumbarungothic"
                android:layout_gravity="start"
                android:layout_marginTop="30dp"/>

            <EditText
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/edittext_selector"
                android:paddingLeft="15dp"
                android:textColor="#111111"
                android:gravity="center_vertical|start"
                android:fontFamily="@font/nanumbarungothic"
                android:hint="‘-’  없이 숫자만 입력"
                android:textAppearance="@style/HintTextStyle"
                android:textColorHint="#C7C7C7"
                android:layout_marginTop="5dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"/>

            <LinearLayout
                android:id="@+id/email_error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/email_warn"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_warning"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/email_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="올바른 형식의 이메일 주소 전체를 입력해 주세요."
                    android:textSize="12sp"
                    android:textColor="#FF0C00"
                    android:fontFamily="@font/nanumsquarebold"
                    android:visibility="gone"/>
            </LinearLayout>


            <!-- 약관 체크 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="30dp">

                <CheckBox
                    android:id="@+id/service_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#111111"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(필수) 서비스 이용 약관 동의 "
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:fontFamily="@font/nanumbarungothic"/>

                <TextView
                    android:id="@+id/service_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[보기]"
                    android:textSize="12sp"
                    android:textColor="#5588FF"
                    android:fontFamily="@font/nanumbarungothicbold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp">

                <CheckBox
                    android:id="@+id/privacy_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#111111"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(필수) 개인정보 처리방침 동의 "
                    android:textSize="12sp"
                    android:textColor="#111111"
                    android:fontFamily="@font/nanumbarungothic"/>

                <TextView
                    android:id="@+id/privacy_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[보기]"
                    android:textSize="12sp"
                    android:textColor="#5588FF"
                    android:fontFamily="@font/nanumbarungothicbold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#00000012"
                android:layout_marginTop="32dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/bottom_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/btn_check"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/check_default"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
