<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색 -->
    <solid android:color="#FFFFFF"/>

    <!-- 모서리 라운드 -->
    <corners android:radius="20dp"/>

    <!-- 회색 테두리 추가 -->
    <stroke
        android:width="1dp"
        android:color="#D5D5D5" />

    <!-- 내부 패딩 -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp"/>
</shape>
